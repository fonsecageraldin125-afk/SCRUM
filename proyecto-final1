                if guardar and self.usuario:
                    mensaje += "\\nSe guardaron para esta cuenta."
                messagebox.showinfo("Personalización aplicada", mensaje)
        except tk.TclError as error:
            messagebox.showerror("Error de apariencia", str(error))

