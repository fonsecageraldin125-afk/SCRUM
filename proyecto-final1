    def aplicar_colores(self, colores, guardar=True, mostrar_mensaje=True):
        global FONDO, PANEL, GRAFITO, AMARILLO, CIAN, MAGENTA
        global TEXTO, SECUNDARIO, ENTRADA, BLANCO, AZUL, AZUL_BOTON
        global AZUL_CLARO, GRIS
